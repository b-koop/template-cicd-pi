# Optional provider override. Leave blank when the model includes its provider.
PI_PROVIDER=
# Select a model supported by your installed agent CLI.
PI_MODEL=anthropic/claude-sonnet-4-5

# Set only the provider key you use. Never commit a real value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional token referenced by examples/connections.example.json.
EXAMPLE_SERVICE_TOKEN=
